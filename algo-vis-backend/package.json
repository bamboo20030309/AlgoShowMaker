{
  "name": "algo-vis-backend",
  "version": "1.0.0",
  "description": "後端編譯 C++，並提供靜態前端",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "test:legacy-objects": "node --test tests/slide-inline-scripts.test.js tests/inline-scripts.browser.test.js tests/table-widget.browser.test.js",
    "regression": "node scripts/validation/regression.js",
    "regression:fresh": "node scripts/validation/regression.js --fresh",
    "regression:tests": "node scripts/validation/regression.js --tests-only",
    "regression:tests:fresh": "node scripts/validation/regression.js --tests-only --fresh",
    "regression:animation": "node scripts/validation/regression.js --animation-only",
    "regression:animation:fresh": "node scripts/validation/regression.js --animation-only --fresh",
    "prebuild:guest-decks": "node scripts/build/prebuild-guest-decks.js",
    "prebuild:default-algorithm": "node scripts/build/prebuild-default-algorithm.js",
    "loadtest:compile": "node scripts/benchmarks/compile-load-test.js",
    "test:inventory": "node scripts/validation/validation-manifest.js",
    "validate:backend-linux": "node scripts/validation/validate-backend-linux.js"
  },
  "dependencies": {
    "@jaames/iro": "^5.5.2",
    "@lezer/cpp": "^1.1.6",
    "ace-builds": "^1.44.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "fabric": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.3",
    "nodemailer": "^7.0.12",
    "reveal.js": "^6.0.1"
  },
  "devDependencies": {
    "acorn": "^8.16.0",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.63.0"
  }
}
